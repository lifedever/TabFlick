<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>TabFlick</string>
    <key>CFBundleDisplayName</key>
    <string>TabFlick</string>
    <key>CFBundleIdentifier</key>
    <string>com.lifedever.TabFlick</string>
    <key>CFBundleExecutable</key>
    <string>TabFlick</string>
    <key>CFBundleIconFile</key>
    <string>TabFlick</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <!-- 由 scripts/build-app.sh 注入 -->
    <!-- 没有 .lproj，进程首选本地化会退成英文，Launch Services 给 App 名字做本地化
         时就全是英文（搜索面板「应用」模式里 Weather / WeChat 而不是天气 / 微信）。
         允许混合本地化后按系统语言取。 -->
    <!-- 声明支持的语言：系统设置 → 通用 → 语言与地区 → App 里才能单独给 TabFlick 选语言。
         文案本身不在 .lproj 里（见 L10n.swift），这里只是告诉系统有哪些。 -->
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>en</string>
        <string>ja</string>
        <string>ko</string>
        <string>es</string>
        <string>fr</string>
        <string>de</string>
    </array>
    <key>CFBundleAllowMixedLocalizations</key>
    <true/>
    <key>CFBundleShortVersionString</key>
    <string>__VERSION__</string>
    <key>CFBundleVersion</key>
    <string>__BUILD__</string>

    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- 没有 Dock 图标、没有主窗口：TabFlick 只活在菜单栏里 -->
    <key>LSUIElement</key>
    <true/>

    <!-- 「收藏当前 Finder 目录」要向 Finder 询问前窗口位置（Apple Events）。
         缺这个 key 的话 macOS 直接拒绝，连「自动化」授权框都不弹。 -->
    <key>NSAppleEventsUsageDescription</key>
    <string>TabFlick 需要询问 Finder 当前窗口的文件夹位置，用于「收藏当前 Finder 目录」。TabFlick asks Finder for its front window's folder when you favorite it.</string>

    <key>NSHumanReadableCopyright</key>
    <string>MIT License © lifedever</string>
</dict>
</plist>
