        "options": [
          {
            "value": "hot",
            "title": {
              "zh-Hans": "今日热议",
              "zh-Hant": "今日熱議",
              "en": "Hot today"
            }
          },
          {
            "value": "latest",
            "title": {
              "zh-Hans": "最新主题",
              "zh-Hant": "最新主題",
              "en": "Latest"
            }
          }
        ]
      },
      {
        "key": "count",
        "title": {
          "zh-Hans": "条数",
          "zh-Hant": "條數",
          "en": "Items"
